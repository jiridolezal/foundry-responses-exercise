# Copy to .env and fill in the values you got from the lecturer.
# Endpoint of the Foundry resource (the same host the portal's "View code" shows), ending with /openai/v1/
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/
# Deployment name = what you pass as `model`
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# API key from the lecturer. Leave empty to sign in with Entra ID instead (az login + Foundry User role).
AZURE_OPENAI_API_KEY=
# Optional, Entra ID only: your Foundry project endpoint, for `python responses_api.py conversation`
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
